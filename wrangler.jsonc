{
  // Cloudflare Workers config — production deploy via `wrangler deploy` (DECISIONS.md D2).
  // Secrets go in Worker secrets (`wrangler secret put …`), never in this file (PRD §14).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENV": "development"
  },
  "triggers": {
    // 18:35 UTC ≈ 00:05 IST — daily horoscope generation for the new IST day
    //   (Horoscope Upgrade Step 4; runs are idempotent).
    // 00:15 UTC (05:45 IST) — daily panchang cache warm + prune (Epic 3.1b);
    //   the scheduled handler runs both jobs on every trigger, both idempotent,
    //   so the second firing of each is a cheap no-op refresh.
    "crons": ["35 18 * * *", "15 0 * * *"]
  }
}
