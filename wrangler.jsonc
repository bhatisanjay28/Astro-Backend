{
  // Cloudflare Workers config — production deploy via `wrangler deploy` (DECISIONS.md D2).
  // Secrets go in Worker secrets (`wrangler secret put …`), never in this file (PRD §14).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENV": "development"
  },
  "triggers": {
    // daily panchang cache warm + prune (Epic 3.1b) — 00:15 UTC
    "crons": ["15 0 * * *"]
  }
  // ^ Cron Triggers land with 3.1b; horoscope refresh stays lazy (sweep on read).
}
