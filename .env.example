# Astro-Backend environment template (PRD §10, §14)
# Copy to .env for `bun run dev` — NEVER commit .env with real values.
# In production these become Worker secrets: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`

# deployment marker (dev | staging | prod)
ENV=development

# local dev port for the Bun server
PORT=3000

# --- Supabase (Epic 0.4) — server-only, D3: never exposed to the frontend ---
# Fill after the guided dev-project creation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
